{
  "schemaVersion": 1,
  "authority": {
    "product": "Codex Micro",
    "codexDesktopVersion": "26.727.51351",
    "codexDesktopBuild": "6119",
    "basis": "Clean-room observable behavior and wire facts",
    "proprietaryCodeIncluded": false
  },
  "constants": {
    "device": {
      "vendorId": 12346,
      "vendorIdHex": "0x303A",
      "codexMicroProductId": 33632,
      "codexMicroProductIdHex": "0x8360",
      "creatorMicroV2ProductIds": [33431, 33432],
      "usagePage": 65280,
      "usagePageHex": "0xFF00",
      "candidateOrder": [
        "usb:codex-micro",
        "usb:creator-micro-v2",
        "bluetooth:codex-micro",
        "bluetooth:creator-micro-v2"
      ]
    },
    "hid": {
      "reportId": 6,
      "rpcChannel": 2,
      "reportLengthBytes": 64,
      "headerLengthBytes": 3,
      "payloadCapacityBytes": 61,
      "macosNonExclusive": true
    },
    "rpc": {
      "idMinimumInclusive": 0,
      "idMaximumExclusive": 999,
      "requestQueueConcurrency": 1,
      "interRequestDelayMs": 50,
      "responseTimeoutMs": 10000,
      "immediateTimeoutRetries": 1,
      "requestFields": ["method", "params", "id"],
      "notificationMethodFields": ["method", "m"],
      "notificationParamsFields": ["params", "p"],
      "responseIdFields": ["id", "i"]
    },
    "methods": {
      "deviceStatus": "device.status",
      "threadLighting": "v.oai.thstatus",
      "rgbConfig": "v.oai.rgbcfg",
      "hidNotification": "v.oai.hid",
      "joystickNotification": "v.oai.rad"
    },
    "actionCodes": {
      "release": 0,
      "press": 1,
      "encoderDetent": 2
    },
    "effects": {
      "off": 0,
      "solid": 1,
      "snake": 2,
      "rainbow": 3,
      "breath": 4,
      "gradient": 5,
      "shallowBreath": 6
    },
    "colors": {
      "working": 3166206,
      "unread": 65356,
      "idle": 16777215,
      "awaitingApproval": 16739584,
      "awaitingResponse": 16739584,
      "error": 16711731,
      "off": 0,
      "voiceRecording": 3050327,
      "voiceProcessing": 16777215,
      "voiceCompleted": 16777215
    },
    "timingsMs": {
      "agentDoubleTap": 350,
      "pushToTalkLatch": 350,
      "microphoneRealtimeLongPress": 500,
      "encoderLongPress": 500,
      "selectionAccent": 4000,
      "inputQuiet": 100,
      "composerHighlight": 2000,
      "joystickHud": 600,
      "conversationScrollStepPixels": 160,
      "transportReconnectBackoff": [1000, 2000, 5000, 10000],
      "lightingRecoveryBackoff": [1000, 2000, 5000, 10000],
      "topologySettle": [250, 1000, 3000],
      "topologyFallbackScan": 30000,
      "batteryRefresh": 60000,
      "defaultAutoDim": 180000
    }
  },
  "defaults": {
    "agentSource": "recent",
    "singleTapAgentKeys": false,
    "brightnessPercent": 100,
    "lightingAutoOff": "3-minutes",
    "voiceButtonMode": "push-to-talk",
    "encoderMode": "composer-navigation",
    "agentKeys": ["AG00", "AG01", "AG02", "AG03", "AG04", "AG05"],
    "actionSlots": {
      "ACT06": {
        "keycapId": "FAST",
        "action": { "type": "command", "commandId": "composer.toggleFastMode" }
      },
      "ACT07": {
        "keycapId": "APPR",
        "action": { "type": "command", "commandId": "approval.approve" }
      },
      "ACT08": {
        "keycapId": "REJ",
        "action": { "type": "command", "commandId": "approval.decline" }
      },
      "ACT09": {
        "keycapId": "SPLIT",
        "action": { "type": "command", "commandId": "forkThread" }
      },
      "ACT10_ACT11": {
        "keycapId": "MIC",
        "action": { "type": "push-to-talk" },
        "handledEventKey": "ACT10",
        "ignoredEventKey": "ACT11"
      },
      "ACT12": {
        "keycapId": "CODEX",
        "action": { "type": "command", "commandId": "composer.submit" }
      }
    },
    "analogStick": {
      "up": { "type": "command", "commandId": "composer.togglePlanMode" },
      "right": { "type": "command", "commandId": "navigateForward" },
      "down": { "type": "command", "commandId": "toggleSidebar" },
      "left": { "type": "command", "commandId": "navigateBack" }
    },
    "encoderCustom": {
      "left": null,
      "right": null,
      "click": null,
      "longPress": null
    },
    "agentSourceOptions": ["pinned", "recent", "priority", "custom"],
    "encoderModeOptions": [
      "composer-navigation",
      "reasoning",
      "conversation-scroll",
      "custom"
    ],
    "voiceButtonModeOptions": ["push-to-talk", "realtime"],
    "lightingAutoOffOptions": [
      "off",
      "30-seconds",
      "1-minute",
      "3-minutes",
      "10-minutes",
      "30-minutes",
      "1-hour"
    ]
  },
  "statusDerivation": {
    "localPrecedence": [
      { "when": { "status": "error" }, "result": "error" },
      { "when": { "pendingChip": "approval" }, "result": "awaiting-approval" },
      { "when": { "pendingChip": "response" }, "result": "awaiting-response" },
      { "when": { "status": "loading" }, "result": "working" },
      { "when": { "unread": true }, "result": "unread" },
      { "when": {}, "result": "idle" }
    ],
    "remotePrecedence": [
      { "when": { "latestTurnStatus": "failed" }, "result": "error" },
      {
        "whenAny": [
          { "latestTurnStatus": "pending" },
          { "latestTurnStatus": "in_progress" }
        ],
        "result": "working"
      },
      { "when": { "unread": true }, "result": "unread" },
      { "when": {}, "result": "idle" }
    ],
    "selectedFocusedUnreadOverride": {
      "when": { "selected": true, "appWindowFocused": true, "derivedStatus": "unread" },
      "result": "idle"
    },
    "ambientPrecedence": [
      "snakingAmbientStatus",
      "voiceState",
      "selectedSlot",
      "off"
    ]
  },
  "connectionFixtures": [
    {
      "name": "cold-connect",
      "states": ["not-detected", "detected", "connected"],
      "lifecycleTransition": "connected"
    },
    {
      "name": "detected-connect-failure",
      "states": ["not-detected", "detected", "error"],
      "error": "connection-failed",
      "lifecycleTransition": "connection-failed",
      "retryDelaysMs": [1000, 2000, 5000, 10000, 10000]
    },
    {
      "name": "active-transport-loss-and-recovery",
      "states": ["connected", "error", "connected"],
      "error": "transport-unavailable",
      "lifecycleTransitions": ["connection-lost", "reconnected"]
    },
    {
      "name": "successful-usb-bluetooth-handoff",
      "states": ["connected", "not-detected", "detected", "connected"],
      "cause": "transport-handoff",
      "lifecycleTransitions": []
    },
    {
      "name": "locked-session-input",
      "input": { "method": "v.oai.hid", "params": { "k": "AG00", "act": 1 } },
      "sessionLocked": true,
      "expected": { "routedEvents": [], "ownerWindow": null }
    }
  ],
  "inputFixtures": [
    {
      "name": "agent-first-tap-background-navigation",
      "settings": { "singleTapAgentKeys": false },
      "displayedAssignment": { "slot": 0, "threadKey": "thread-a" },
      "events": [
        { "atMs": 0, "key": "AG00", "act": 1 }
      ],
      "expectedActions": [
        { "atMs": 0, "type": "navigate-thread", "threadKey": "thread-a", "foreground": false }
      ]
    },
    {
      "name": "agent-double-tap-foreground",
