  "statusFixtures": [
    {
      "name": "local-error-wins-over-approval-loading-unread",
      "input": { "status": "error", "pendingChip": "approval", "unread": true },
      "expected": "error"
    },
    {
      "name": "local-approval-wins-over-response-loading-unread",
      "input": { "status": "loading", "pendingChip": "approval", "unread": true },
      "expected": "awaiting-approval"
    },
    {
      "name": "local-response-wins-over-loading-unread",
      "input": { "status": "loading", "pendingChip": "response", "unread": true },
      "expected": "awaiting-response"
    },
    {
      "name": "local-loading-wins-over-unread",
      "input": { "status": "loading", "pendingChip": null, "unread": true },
      "expected": "working"
    },
    {
      "name": "selected-focused-unread-renders-idle",
      "input": {
        "status": "idle",
        "pendingChip": null,
        "unread": true,
        "selected": true,
        "appWindowFocused": true
      },
      "derived": "unread",
      "expectedRendered": "idle"
    },
    {
      "name": "remote-failed-wins",
      "input": { "latestTurnStatus": "failed", "unread": true },
      "expected": "error"
    },
    {
      "name": "remote-in-progress-wins-over-unread",
      "input": { "latestTurnStatus": "in_progress", "unread": true },
      "expected": "working"
    }
  ],
