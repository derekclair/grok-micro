        { "atMs": 0, "key": "AG00", "act": 1 },
        { "atMs": 349, "key": "AG00", "act": 1 }
      ],
      "expectedActions": [
        { "atMs": 0, "type": "navigate-thread", "threadKey": "thread-a", "foreground": false },
